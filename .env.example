# Клиент (GitHub Pages) — только публичные значения
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Edge Functions (Supabase Secrets, НЕ в репозитории и НЕ в клиенте):
#   supabase secrets set SUPABASE_DB_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY доступны функциям автоматически.
