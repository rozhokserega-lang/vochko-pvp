{
  "name": "vochko-pvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:core": "node tests/browser-nexus-core.mjs",
    "test:browser": "node tests/browser-elements.mjs",
    "test:local": "node tests/browser-local.mjs",
    "test:waiting": "node tests/browser-waiting-room.mjs",
    "test:network:live": "node tests/browser-network-live.mjs --allow-live",
    "test:nexus": "node tests/browser-nexus.mjs",
    "test:browser:live": "node tests/browser-v19.mjs",
    "tournament": "node scripts/tournament.mjs --all --games 1000 --seed 1",
    "ablation": "node scripts/ablation.mjs 300 1",
    "build": "vite build",
    "standalone": "vite build --base=./ && node scripts/make-standalone.mjs",
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "vite": "^8.3.7"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "sharp": "^0.35.5"
  }
}
